# ingest-svc — variáveis de ambiente
# Copie para .env (gitignored) e preencha pra rodar local.

# AssemblyAI — pegue em https://www.assemblyai.com/app/api-keys
# Universal-2 + Universal-3-Pro (single-shot até 10h, diarização global)
ASSEMBLYAI_API_KEY=

# Mesmo WEBHOOK_TOKEN do .env raiz (mac-agent usa o mesmo)
# Usado pelo legacy path X-Auth + X-User-Id (mac-agent). App iOS usa Bearer (abaixo).
INGEST_TOKEN=CHANGE_ME_TOKEN_LONGO_E_ALEATORIO

# Webhook do n8n "Acoes - Audio Ingest" — mesmo que o mac-agent posta
N8N_WEBHOOK_URL=https://n8n-n8n.ymnmx7.easypanel.host/webhook/acoes-audio-ingest

# ─── App iOS (Authorization: Bearer <session_token>) ────────────────
# Shared secret entre ingest-svc e frontend Next.js — também precisa estar
# setado no env do frontend (mesma string). Use openssl rand -hex 32.
INTERNAL_SVC_TOKEN=CHANGE_ME_INTERNAL_SECRET

# Base URL do frontend pra resolver tokens. No easypanel, é o DNS interno
# do service (sem precisar TLS): http://<service-name>:3000
# Em local: http://localhost:3000
FRONTEND_INTERNAL_URL=http://assistente-frontend:3000

# Opcional: lista ordenada de speech_models (fallback automático)
# Default: ["universal-3-pro","universal-2"]
# SPEECH_MODELS_JSON=["universal-3-pro","universal-2"]

# Opcional: intervalo entre polls de status (default 8s)
# POLL_INTERVAL=8

# Opcional: timeout total de polling em segundos (default 3600 = 60min)
# POLL_MAX_SECONDS=3600

# Opcional: timeout em segundos pro POST pro n8n (default 300)
# N8N_TIMEOUT_SECONDS=300

# Opcional: tamanho máximo de upload em bytes (default 1.5GB = 1610612736)
# Cobre ~24h de m4a cru a 64kbps. Bytes gravados em streaming (não vão pra RAM).
# MAX_UPLOAD_BYTES=1610612736

# Opcional: limite defensivo de duração do áudio PÓS-silenceremove em segundos.
# AssemblyAI rejeita > 10h (36000s). 35880 = 9h58m (margem). Áudio acima disso vai
# pra JOBS_DIR/failed/ em vez de quebrar.
# MAX_AUDIO_SECONDS=35880

# Opcional: diretório DURÁVEL pros jobs (cru + sidecar até o n8n confirmar).
# Em prod, montar volume persistente aqui (sobrevive a redeploy do container).
# JOBS_DIR=/data/jobs

# Opcional: quantos jobs pesados (ffmpeg + transcrição) rodam ao mesmo tempo.
# Default 1 (serializa — seguro em 1 vCPU/1GB). Só tem efeito com uvicorn --workers 1.
# MAX_CONCURRENT_JOBS=1
