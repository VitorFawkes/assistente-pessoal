{
  "name": "ler-claude",
  "displayName": "Ler Claude — resumo falado",
  "description": "Botão na barra de status que lê em voz alta um resumo curto (pt-BR) da última resposta da CONVERSA do Claude Code em foco. Voz natural (Google Chirp3-HD) via daemon em ~/.claude/voice. Opcional, por projeto: pré-geração automática (toca na hora) ou falar sozinho ao terminar.",
  "version": "0.8.0",
  "publisher": "vitorgambetti",
  "engines": {
    "vscode": "^1.95.0"
  },
  "license": "MIT",
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeReadAloud.speak",
        "title": "Ler resumo da última resposta do Claude",
        "icon": "$(unmute)"
      },
      {
        "command": "claudeReadAloud.toggle",
        "title": "Pausar / continuar a leitura",
        "icon": "$(debug-pause)"
      },
      {
        "command": "claudeReadAloud.pause",
        "title": "Pausar a leitura",
        "icon": "$(debug-pause)"
      },
      {
        "command": "claudeReadAloud.resume",
        "title": "Continuar a leitura",
        "icon": "$(play)"
      },
      {
        "command": "claudeReadAloud.stop",
        "title": "Calar voz (parar leitura)",
        "icon": "$(mute)"
      },
      {
        "command": "claudeReadAloud.toggleAutoPrep",
        "title": "Auto-resumo: ligar/desligar pré-geração neste projeto",
        "icon": "$(broadcast)"
      },
      {
        "command": "claudeReadAloud.toggleAutoSpeak",
        "title": "Falar sozinho: ligar/desligar fala automática ao terminar neste projeto",
        "icon": "$(megaphone)"
      }
    ],
    "keybindings": [
      {
        "command": "claudeReadAloud.speak",
        "key": "cmd+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "claudeReadAloud.toggle",
        "key": "cmd+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "claudeReadAloud.stop",
        "key": "cmd+alt+.",
        "mac": "cmd+alt+."
      }
    ],
    "configuration": {
      "title": "Ler Claude",
      "properties": {
        "claudeReadAloud.port": {
          "type": "number",
          "default": 8765,
          "description": "Porta do daemon de voz (~/.claude/voice/tts_server.py)."
        },
        "claudeReadAloud.voicectlPath": {
          "type": "string",
          "default": "~/.claude/voice/voicectl.sh",
          "description": "Script que sobe o daemon de voz se ele estiver fora do ar."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.0"
  }
}
