# ─────────────────────────────────────────────────────────────────────
# Assistente Pessoal — variáveis de ambiente
# Copie para `.env` e preencha. NÃO commite o .env.
# ─────────────────────────────────────────────────────────────────────

# ─── Mac agent (lido por mac-agent/audio-watcher.sh) ─────────────────
WEBHOOK_URL=https://n8n-n8n.ymnmx7.easypanel.host/webhook/acoes-audio-ingest
WEBHOOK_TOKEN=CHANGE_ME_TOKEN_LONGO_E_ALEATORIO

MACBOOK_FOLDER=/Users/vitorgambetti/Documents/AudiosMacbook
IPHONE_FOLDER=/Users/vitorgambetti/Documents/AudiosIphone

# ─── n8n (configurar como credentials no n8n, não aqui) ──────────────
# OPENAI_API_KEY=<já existe como credencial no n8n>
# Os workflows referenciam essas credenciais por ID — ver n8n-workflows/

# ─── Postgres (easypanel) ────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/assistente_pessoal
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=assistente_pessoal
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── Evolution API (WhatsApp) ────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_DESTINO=

# ─── Frontend ────────────────────────────────────────────────────────
FRONTEND_DOMAIN=acoes.exemplo.com
BASIC_AUTH_USER=vitor
BASIC_AUTH_PASS=CHANGE_ME

# voice-svc (microservice de fingerprinting de voz) — DNS interno do easypanel
VOICE_SVC_URL=http://voice-svc:8000

# Webhook n8n que reprocessa tarefas após edição de speaker_labels
N8N_REPROCESS_URL=https://n8n.vitorgambetti.com.br/webhook/acoes-reprocess-tarefas

# ─── easypanel (só usado pelos scripts de provisão) ─────────────────
EASYPANEL_URL=https://easypanel-domain.example
EASYPANEL_TOKEN=
