      "parameters": {
        "jsCode": "\nconst wh = $('1. Webhook').first();\nconst headers = wh.json.headers || {};\nconst filename = headers['x-original-filename'] || 'audio.mp3';\nconst ext = (filename.split('.').pop() || 'mp3').toLowerCase();\n// UUID v4 manual (sandbox bloqueia crypto)\nconst uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n  const r = (Math.random() * 16) | 0;\n  return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);\n});\nconst meeting_id = uuid;\nconst now = new Date();\nconst year  = String(now.getUTCFullYear());\nconst month = String(now.getUTCMonth() + 1).padStart(2, '0');\nconst recorded_at = headers['x-recorded-at'] || now.toISOString();\n\nreturn [{\n  json: {\n    meeting_id,\n    year, month,\n    source: headers['x-source'] || 'macbook',\n    meeting_type: headers['x-meeting-type'] || 'desconhecido',\n    original_filename: filename,\n    recorded_at,\n    audio_size_bytes: parseInt(headers['x-audio-size'] || '0', 10),\n    ext,\n    audio_path: `/audios/${meeting_id}.${ext}`\n  },\n  binary: wh.binary\n}];\n"
