    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE meetings\n   SET status = 'done',\n       summary = $1,\n       raw_ai_response = $2::jsonb,\n       done_at = now()\n WHERE id = $3\n RETURNING id,\n          (SELECT count(*) FROM tarefas WHERE meeting_id = meetings.id) AS n_tarefas;",
        "options": {
          "queryReplacement": "={{ $('9. Parse Actions').first().json.summary }},={{ $('9. Parse Actions').first().json.raw_ai_response }},={{ $('3. Prepare Metadata').item.json.meeting_id }}"
        }
      },
      "id": "00000000-0000-0000-0000-000000000013",
      "name": "12. UPDATE meeting (done)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [800, 0]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Monta a mensagem do WhatsApp\nconst meetingId = $('3. Prepare Metadata').item.json.meeting_id;\nconst summary = $('9. Parse Actions').first().json.summary;\nconst items = $('9. Parse Actions').all().map(i => i.json).filter(j => !j.no_actions);\n\nconst minhas = items.filter(i => i.owner === 'vitor');\nconst delegadas = items.filter(i => i.owner !== 'vitor');\nconst formatPrazo = (p) => {\n  if (!p) return '';\n  try {\n    const d = new Date(p);\n    return ' _(até ' + d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' }) + ')_';\n  } catch { return ''; }\n};\nconst emojiPrio = { urgente: '🔴', alta: '🟠', media: '🟡', baixa: '⚪' };\n\nlet msg = '🎙️ *Reunião processada*\\n\\n';\nmsg += '_' + summary + '_\\n\\n';\n\nif (minhas.length) {\n  msg += '✅ *Minhas ações* (' + minhas.length + ')\\n';\n  minhas.forEach(t => {\n    msg += (emojiPrio[t.prioridade] || '🟡') + ' ' + t.titulo + formatPrazo(t.prazo) + '\\n';\n  });\n  msg += '\\n';\n}\n\nif (delegadas.length) {\n  msg += '👥 *Combinei com outros* (' + delegadas.length + ')\\n';\n  delegadas.forEach(t => {\n    msg += (emojiPrio[t.prioridade] || '🟡') + ' *' + t.owner + ':* ' + t.titulo + formatPrazo(t.prazo) + '\\n';\n  });\n  msg += '\\n';\n}\n\nif (!minhas.length && !delegadas.length) {\n  msg += '_(nenhuma ação concreta extraída desta reunião)_\\n';\n}\n\nconst frontendUrl = $env.FRONTEND_URL_ACOES || 'https://acoes.exemplo.com';\nmsg += '🔗 ' + frontendUrl + '/reunioes/' + meetingId;\n\nreturn [{ json: { text: msg, meeting_id: meetingId, n_tarefas: items.length } }];"
      },
      "id": "00000000-0000-0000-0000-000000000014",
