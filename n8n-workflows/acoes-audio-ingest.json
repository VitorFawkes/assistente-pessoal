              "content": "=Transcri\u00e7\u00e3o da reuni\u00e3o ({{ $('3. Prepare Metadata').item.json.meeting_type }}, gravada em {{ $('3. Prepare Metadata').item.json.recorded_at }}):\n\n{{ $('6. Whisper Transcription').item.json.text }}"
