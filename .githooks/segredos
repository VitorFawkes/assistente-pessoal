#!/usr/bin/env python3
"""Trava de segredos do Ações (24/09/2026).

O repositório é público: nenhum commit e nenhum push saem com chave, senha ou token.
Duas conferências, só nas linhas acrescentadas:
  1. o valor exato de cada segredo guardado nos .env da pasta principal (pega chave nossa em qualquer formato);
  2. o gitleaks, com as regras padrão e as do .gitleaks.toml (pega chave nova que ainda não está no .env).
Os ganchos chamam "segredos staged" (pre-commit) e "segredos push" (pre-push, que manda as linhas do git no stdin).
No Mac do Vitor fica instalado em ~/.acoes/githooks (core.hooksPath do repositório); a fonte é .githooks/ no repo.
"""
import re
import shutil
import subprocess
import sys
from pathlib import Path

ZERO = "0" * 40
SECRET_NAME = re.compile(r"(TOKEN|SECRET|PASSWORD|PASSWD|PASS|PWD|_KEY)$")
URL_PASSWORD = re.compile(r"://[^:@/\s]+:([^@/\s]+)@")


def git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True, errors="replace").stdout


def secret_values(root: Path) -> dict:
    """Valor -> nome da variável. Os valores nunca são impressos."""
    files = [p for p in root.glob(".env*") if not p.name.endswith(".example")]
    files += [root / "frontend/.env.local", Path.home() / ".config/superpowers/multitenant-roles.txt"]
    values = {}
    for path in files:
        try:
            lines = path.read_text(errors="ignore").splitlines()
        except OSError:
            continue
        for line in lines:
            m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*[=:]\s*(.*)$", line)
            if not m:
                continue
            name, value = m.group(1).upper(), m.group(2).strip().strip("'\"")
            for v in URL_PASSWORD.findall(value) + ([value] if SECRET_NAME.search(name) else []):
                if len(v) >= 10 and not v.isdigit() and not re.search(r"[$<>{}\s]", v):
                    values.setdefault(v, name)
    return values


def exact_hits(patch: str, values: dict) -> list:
    hits, file, prev = set(), "?", ""
    for line in patch.splitlines():
        if line.startswith("+++ ") and prev.startswith("--- "):
            file = line[6:] if line.startswith("+++ b/") else line[4:]
        elif line.startswith("+"):
            hits.update(f"{file}: tem o valor de {name} (.env)" for v, name in values.items() if v in line)
        prev = line
    return sorted(hits)


def push_ranges(stdin: str) -> list:
    ranges = []
    for line in stdin.splitlines():
        parts = line.split()
        if len(parts) != 4 or parts[1] == ZERO:
            continue
        local, remote = parts[1], parts[3]
        known = remote != ZERO and subprocess.run(["git", "cat-file", "-e", f"{remote}^{{commit}}"], capture_output=True).returncode == 0
        ranges.append([f"{remote}..{local}"] if known else [local, "--not", "--remotes"])
    return ranges


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else "staged"
    top = Path(git("rev-parse", "--show-toplevel").strip())
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir").strip())
    config = top / ".gitleaks.toml"
    if not config.exists():
        config = Path(__file__).resolve().parent / "gitleaks.toml"
    gitleaks = shutil.which("gitleaks") or "/opt/homebrew/bin/gitleaks"
    if not Path(gitleaks).exists():
        print("🚫 trava de segredos: o gitleaks não está instalado (brew install gitleaks).", file=sys.stderr)
        return 1
    base = [gitleaks, "git", "--no-banner", "--no-color", "--redact", "-v", "-c", str(config)]
    if mode == "push":
        ranges = push_ranges(sys.stdin.read())
        patch = "".join(git("log", "-p", "-U0", "--no-color", "--no-ext-diff", "--format=", *r) for r in ranges)
        scans = [base + ["--log-opts", " ".join(r)] for r in ranges]
    else:
        patch = git("diff", "--cached", "-U0", "--no-color", "--no-ext-diff")
        scans = [base + ["--pre-commit", "--staged"]]
    problems = exact_hits(patch, secret_values(common.parent))
    for cmd in scans:
        r = subprocess.run(cmd + [str(top)], capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            problems.append((r.stdout + r.stderr).strip())
    if problems:
        print("🚫 trava de segredos: o repositório é público e isto tem chave, senha ou token.\n", file=sys.stderr)
        print("\n".join(problems), file=sys.stderr)
        print("\nTire o valor do arquivo e leia da variável de ambiente (.env). Nada foi gravado nem enviado.", file=sys.stderr)
        print('Falso positivo do gitleaks: acrescente "gitleaks:allow" no fim da linha.', file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
