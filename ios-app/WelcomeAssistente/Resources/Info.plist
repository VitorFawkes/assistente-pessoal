    <string>TTARS BR usa o microfone pra gravar suas reuniões e extrair tarefas automaticamente.</string>
    <key>WelcomeBaseURL</key>
    <string>$(WELCOME_BASE_URL)</string>
    <key>WelcomeIngestURL</key>
    <string>$(WELCOME_INGEST_URL)</string>
